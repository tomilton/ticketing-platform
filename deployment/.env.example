# Local values. Copy to .env (not versioned); every key must match a ${VAR} of application*.yaml.

# Application
APP_PORT=8080
APP_NAME=ticketing-platform
APP_ROLE=api
LOG_STRUCTURED_FORMAT=ecs
REACTOR_CONTEXT_PROPAGATION=auto
CORS_ALLOWED_ORIGINS=http://localhost:4200
MANAGEMENT_ENDPOINTS_EXPOSURE=health,prometheus
MANAGEMENT_HEALTH_PROBES_ENABLED=true

# Routes
ROUTES_BASE_PATH=/api/v1
ROUTES_EVENTS=/events
ROUTES_EVENT_BY_ID=/events/{eventId}
ROUTES_EVENT_AVAILABILITY=/events/{eventId}/availability
ROUTES_BATCH_AVAILABILITY=/events/availability
ROUTES_AVAILABILITY_STREAM=/events/{eventId}/availability/stream

# DynamoDB
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566
DYNAMODB_EVENTS_TABLE=events
DYNAMODB_INVENTORY_TABLE=inventory
DYNAMODB_EVENTS_BY_STATUS_DATE_INDEX=by-status-date
DYNAMODB_API_CALL_TIMEOUT=PT2S
DYNAMODB_API_CALL_ATTEMPT_TIMEOUT=PT0.5S
DYNAMODB_BATCH_CONCURRENCY=4
DYNAMODB_HEALTH_CHECK_TIMEOUT=PT1S

# Business
INVENTORY_SHARD_COUNT=1
AVAILABILITY_POLL_INTERVAL=PT1S
AVAILABILITY_BATCH_MAX_IDS=100
AVAILABILITY_STREAM_HEARTBEAT=PT15S
AVAILABILITY_STREAM_MAX_DURATION=PT30M
AVAILABILITY_STREAM_RETRY=PT1S
EVENTS_PAGE_DEFAULT_SIZE=20
EVENTS_PAGE_MAX_SIZE=100

# Fake credentials, read only by the AWS SDK and LocalStack
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
