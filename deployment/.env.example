# Local values. Copy to .env (not versioned); every key must match a ${VAR} of application*.yaml.

# Application
APP_PORT=8080
APP_NAME=ticketing-platform
APP_ROLE=api
LOG_STRUCTURED_FORMAT=ecs
REACTOR_CONTEXT_PROPAGATION=auto
CORS_ALLOWED_ORIGINS=http://localhost:4200
MANAGEMENT_ENDPOINTS_EXPOSURE=health,prometheus
MANAGEMENT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_HEALTH_SHOW_COMPONENTS=always

# Routes
ROUTES_BASE_PATH=/api/v1
ROUTES_EVENTS=/events
ROUTES_EVENT_BY_ID=/events/{eventId}
ROUTES_EVENT_AVAILABILITY=/events/{eventId}/availability
ROUTES_BATCH_AVAILABILITY=/events/availability
ROUTES_AVAILABILITY_STREAM=/events/{eventId}/availability/stream
ROUTES_ORDERS=/orders
ROUTES_ORDER_BY_ID=/orders/{orderId}

# DynamoDB
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566
DYNAMODB_EVENTS_TABLE=events
DYNAMODB_INVENTORY_TABLE=inventory
DYNAMODB_EVENTS_BY_STATUS_DATE_INDEX=by-status-date
DYNAMODB_API_CALL_TIMEOUT=PT2S
DYNAMODB_API_CALL_ATTEMPT_TIMEOUT=PT0.5S
DYNAMODB_BATCH_CONCURRENCY=4
DYNAMODB_HEALTH_CHECK_TIMEOUT=PT1S
DYNAMODB_ORDERS_TABLE=orders
DYNAMODB_ORDER_AUDIT_TABLE=order_audit
DYNAMODB_IDEMPOTENCY_TABLE=idempotency
DYNAMODB_CUSTOMER_LIMITS_TABLE=customer_event_limits
DYNAMODB_EXPIRING_RESERVATIONS_INDEX=expiring-reservations
DYNAMODB_PENDING_PUBLICATION_INDEX=pending-publication
DYNAMODB_TRANSACTION_CONFLICT_RETRIES=10
DYNAMODB_RESERVE_TIMEOUT=PT5S

# SQS
SQS_ORDER_PLACED_QUEUE=order-placed
SQS_ORDER_PLACED_DLQ=order-placed-dlq
SQS_SEND_TIMEOUT=PT1S
SQS_WAIT_TIME=PT20S
SQS_MAX_MESSAGES=10
SQS_MAX_CONCURRENCY=8

# Only for the init scripts and docker-compose
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_SECONDS=60
WORKER_PORT=8081

# Payment simulator
PAYMENT_SIMULATOR_MODE=APPROVE
PAYMENT_SIMULATOR_LATENCY=PT0.2S
PAYMENT_TIMEOUT=PT2S

# Business
INVENTORY_SHARD_COUNT=1
AVAILABILITY_POLL_INTERVAL=PT1S
AVAILABILITY_BATCH_MAX_IDS=100
AVAILABILITY_STREAM_HEARTBEAT=PT15S
AVAILABILITY_STREAM_MAX_DURATION=PT30M
AVAILABILITY_STREAM_RETRY=PT1S
EVENTS_PAGE_DEFAULT_SIZE=20
EVENTS_PAGE_MAX_SIZE=100
ORDERS_MAX_TICKETS_PER_ORDER=6
ORDERS_MAX_TICKETS_PER_CUSTOMER=6
ORDERS_RESERVATION_TTL=PT10M
ORDERS_REPUBLISH_INTERVAL=PT10S
ORDERS_REPUBLISH_GRACE=PT5S
ORDERS_REPUBLISH_CONCURRENCY=4
IDEMPOTENCY_TTL=PT24H
IDEMPOTENCY_LEASE=PT10S

# Fake credentials, read only by the AWS SDK and LocalStack
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Local SonarQube of the quality profile (not an application variable)
SONAR_PORT=9000
