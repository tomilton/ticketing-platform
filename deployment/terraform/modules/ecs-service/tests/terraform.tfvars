name                    = "ticketing-test"
role                    = "api"
region                  = "us-east-1"
cluster_arn             = "arn:aws:ecs:us-east-1:123456789012:cluster/ticketing-test"
cluster_name            = "ticketing-test"
image                   = "123456789012.dkr.ecr.us-east-1.amazonaws.com/ticketing-platform:1.3.0"
ecr_repository_arn      = "arn:aws:ecr:us-east-1:123456789012:repository/ticketing-platform"
cpu                     = 512
memory                  = 1024
container_port          = 8080
health_check_path       = "/actuator/health"
min_capacity            = 2
max_capacity            = 6
vpc_id                  = "vpc-test"
vpc_cidr_block          = "10.20.0.0/16"
subnet_ids              = ["subnet-a", "subnet-b", "subnet-c"]
gateway_prefix_list_ids = { dynamodb = "pl-dynamodb", s3 = "pl-s3" }
load_balancer = {
  security_group_id       = "sg-alb"
  target_group_arn        = "arn:aws:elasticloadbalancing:us-east-1:123456789012:targetgroup/api/1"
  alb_arn_suffix          = "app/ticketing-test-api/1"
  target_group_arn_suffix = "targetgroup/ticketing-test-api/1"
}
log_retention_days = 30
table_names = {
  events                 = "events"
  inventory              = "inventory"
  orders                 = "orders"
  order_audit            = "order_audit"
  idempotency            = "idempotency"
  customer_limits        = "customer_event_limits"
  scheduler_locks        = "scheduler_locks"
  payment_webhook_events = "payment_webhook_events"
}
table_arns = {
  events                 = "arn:aws:dynamodb:us-east-1:123456789012:table/events"
  inventory              = "arn:aws:dynamodb:us-east-1:123456789012:table/inventory"
  orders                 = "arn:aws:dynamodb:us-east-1:123456789012:table/orders"
  order_audit            = "arn:aws:dynamodb:us-east-1:123456789012:table/order_audit"
  idempotency            = "arn:aws:dynamodb:us-east-1:123456789012:table/idempotency"
  customer_limits        = "arn:aws:dynamodb:us-east-1:123456789012:table/customer_event_limits"
  scheduler_locks        = "arn:aws:dynamodb:us-east-1:123456789012:table/scheduler_locks"
  payment_webhook_events = "arn:aws:dynamodb:us-east-1:123456789012:table/payment_webhook_events"
}
index_names = {
  events_by_status_date = "by-status-date"
  expiring_reservations = "expiring-reservations"
  pending_publication   = "pending-publication"
}
queue = {
  name                   = "order-placed"
  arn                    = "arn:aws:sqs:us-east-1:123456789012:order-placed"
  dead_letter_queue_name = "order-placed-dlq"
  dead_letter_queue_arn  = "arn:aws:sqs:us-east-1:123456789012:order-placed-dlq"
}
payment_queue = {
  name                   = "payment-confirmed"
  arn                    = "arn:aws:sqs:us-east-1:123456789012:payment-confirmed"
  dead_letter_queue_name = "payment-confirmed-dlq"
  dead_letter_queue_arn  = "arn:aws:sqs:us-east-1:123456789012:payment-confirmed-dlq"
}
secrets = {
  WEBHOOK_HMAC_SECRET = "arn:aws:secretsmanager:us-east-1:123456789012:secret:ticketing-webhook-hmac"
}
kms_key_arns = ["arn:aws:kms:us-east-1:123456789012:key/tables", "arn:aws:kms:us-east-1:123456789012:key/queues"]
settings = {
  CORS_ALLOWED_ORIGINS                  = "https://tickets.example.com"
  JWT_JWK_SET_URI                       = "https://auth.example.com/.well-known/jwks.json"
  JWT_ISSUER                            = "https://auth.example.com"
  JWT_AUDIENCE                          = "ticketing-platform"
  JWT_ROLES_CLAIM                       = "cognito:groups"
  JWT_ADMIN_ROLE                        = "ticketing-admin"
  JWT_CLOCK_SKEW                        = "PT60S"
  MANAGEMENT_HEALTH_SHOW_COMPONENTS     = "never"
  DYNAMODB_API_CALL_TIMEOUT             = "PT2S"
  DYNAMODB_API_CALL_ATTEMPT_TIMEOUT     = "PT0.5S"
  DYNAMODB_BATCH_CONCURRENCY            = "4"
  DYNAMODB_HEALTH_CHECK_TIMEOUT         = "PT1S"
  DYNAMODB_TRANSACTION_CONFLICT_RETRIES = "10"
  DYNAMODB_RESERVE_TIMEOUT              = "PT5S"
  SQS_SEND_TIMEOUT                      = "PT1S"
  SQS_WAIT_TIME                         = "PT20S"
  SQS_MAX_MESSAGES                      = "10"
  SQS_MAX_CONCURRENCY                   = "8"
  PAYMENT_SIMULATOR_MODE                = "APPROVE"
  PAYMENT_SIMULATOR_LATENCY             = "PT0.2S"
  PAYMENT_TIMEOUT                       = "PT2S"
  PAYMENT_SIMULATOR_APPROVAL_RATE       = "0.5"
  PAYMENT_SIMULATOR_SLOW_LATENCY        = "PT5S"
  INVENTORY_SHARD_COUNT                 = "4"
  AVAILABILITY_POLL_INTERVAL            = "PT1S"
  AVAILABILITY_BATCH_MAX_IDS            = "100"
  AVAILABILITY_STREAM_HEARTBEAT         = "PT15S"
  AVAILABILITY_STREAM_MAX_DURATION      = "PT30M"
  AVAILABILITY_STREAM_RETRY             = "PT1S"
  ORDERS_MAX_TICKETS_PER_ORDER          = "6"
  ORDERS_MAX_TICKETS_PER_CUSTOMER       = "6"
  ORDERS_RESERVATION_TTL                = "PT10M"
  ORDERS_REPUBLISH_INTERVAL             = "PT10S"
  ORDERS_REPUBLISH_GRACE                = "PT5S"
  ORDERS_REPUBLISH_CONCURRENCY          = "4"
  SWEEP_INTERVAL                        = "PT30S"
  SWEEP_LOCK_LEASE                      = "PT60S"
  SWEEP_BATCH_SIZE                      = "500"
  SWEEP_CONCURRENCY                     = "8"
  COMPLIMENTARY_MAX_PER_GRANT           = "50"
  IDEMPOTENCY_TTL                       = "PT24H"
  IDEMPOTENCY_LEASE                     = "PT10S"
  EVENTS_PAGE_DEFAULT_SIZE              = "20"
  EVENTS_PAGE_MAX_SIZE                  = "100"
}
scaling = {
  cpu_percent           = 60
  requests_per_target   = 500
  messages_per_scale_up = 100
}
