                "exec": [
                  "pm.test(\"202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"Orden RESERVED con TKS0003\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.meta.code).to.eql(\"TKS0003\");",
                  "  pm.expect(b.data.status).to.eql(\"RESERVED\");",
                  "});",
                  "pm.collectionVariables.set(\"orderDecline\", pm.response.json().data.orderId);"
                ]
              }
