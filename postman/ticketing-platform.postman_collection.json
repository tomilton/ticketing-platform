                "exec": [
                  "setTimeout(() => {}, 4000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Orden CANCELLED\", () => pm.expect(pm.response.json().data.status).to.eql(\"CANCELLED\"));",
                  "pm.test(\"Entradas AVAILABLE\", () => pm.response.json().data.tickets.forEach(t => pm.expect(t.status).to.eql(\"AVAILABLE\")));"
                ]
              }
            }
          ]
