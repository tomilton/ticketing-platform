  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Development tokens signed with HS256 and jwtSecret, the JWT_LOCAL_SECRET of deployment/.env.example.",
          "// The API accepts them only in the local profile; deployments verify tokens of the identity provider.",
          "const base64Url = (words) => CryptoJS.enc.Base64.stringify(words).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "const sign = (claims) => {",
          "  const header = base64Url(CryptoJS.enc.Utf8.parse(JSON.stringify({ alg: 'HS256', typ: 'JWT' })));",
          "  const payload = base64Url(CryptoJS.enc.Utf8.parse(JSON.stringify(claims)));",
          "  return header + '.' + payload + '.' + base64Url(CryptoJS.HmacSHA256(header + '.' + payload, pm.environment.get('jwtSecret')));",
          "};",
          "const now = Math.floor(Date.now() / 1000);",
          "const claims = (subject, admin) => {",
          "  const base = { iss: pm.environment.get('jwtIssuer'), aud: pm.environment.get('jwtAudience'), sub: subject, iat: now, exp: now + 3600 };",
          "  if (admin) { base[pm.environment.get('rolesClaim')] = [pm.environment.get('adminRole')]; }",
          "  return base;",
          "};",
          "pm.collectionVariables.set('customerToken', sign(claims(pm.environment.get('customerId'), false)));",
          "pm.collectionVariables.set('otherCustomerToken', sign(claims(pm.environment.get('otherCustomerId'), false)));",
          "pm.collectionVariables.set('adminToken', sign(claims(pm.environment.get('adminId'), true)));",
          "pm.collectionVariables.set('limitedCustomerToken', sign(claims(pm.collectionVariables.get('limitedCustomerId') || pm.environment.get('customerId'), false)));"
        ]
      }
    }
  ]
